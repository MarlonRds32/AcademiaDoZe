<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:DataType="vm:AlunoViewModel"
             Title="{Binding Title}"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Spacing="20">

            <!-- CPF -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <StackLayout Spacing="5">
                    <Label Text="{helpers:Translate strCpf}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Text="{Binding Aluno.Cpf}" Placeholder="000.000.000-00" Keyboard="Numeric" MaxLength="14" Margin="0,0,10,0" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding SearchByCpfCommand}"/>
                        <Button Grid.Column="1" Text="{helpers:Translate strBuscarCpf}" Command="{Binding SearchByCpfCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="40" Padding="15,0">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="{AppThemeBinding Light={StaticResource Lime}, Dark={StaticResource Ink}}" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </StackLayout>
            </Border>

            <!-- Dados Pessoais -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <StackLayout Spacing="15">
                    <Label Style="{StaticResource SubHeadline}" IsVisible="{Binding IsEditMode}"><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strAlunoId}"/><Span Text=": "/><Span Text="{Binding Aluno.Id}"/></FormattedString></Label.FormattedText></Label>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strNome}"/>
                        <Entry Text="{Binding Aluno.Nome}" Placeholder="{helpers:Translate strDigiteNome}" MaxLength="150" ClearButtonVisibility="WhileEditing"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strDataNascimento}"/>
                        <DatePicker Date="{Binding Aluno.DataNascimento, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}" Format="{helpers:Translate FormatoDataCurta}"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strTelefone}"/>
                        <Entry Text="{Binding Aluno.Telefone}" Placeholder="(00) 00000-0000" Keyboard="Telephone" MaxLength="15" ClearButtonVisibility="WhileEditing"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strEmail}"/>
                        <Entry Text="{Binding Aluno.Email}" Placeholder="{helpers:Translate strEmailExemplo}" Keyboard="Email" MaxLength="100" ClearButtonVisibility="WhileEditing"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strSenha}"/>
                        <Entry Text="{Binding Aluno.Senha}" Placeholder="{helpers:Translate strDigiteSenha}" IsPassword="True" MaxLength="50"/>
                        <Label Text="{helpers:Translate strSenhaManter}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" IsVisible="{Binding IsEditMode}" Margin="2,-2,0,0"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strConfirmarSenha}"/>
                        <Entry Text="{Binding ConfirmarSenha}" Placeholder="{helpers:Translate strConfirmeSenha}" IsPassword="True" MaxLength="50"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strFoto}"/>
                        <Border Style="{StaticResource PhotoFrame}" HorizontalOptions="Start" HeightRequest="126" WidthRequest="126">
                            <Image Source="{Binding Aluno.Foto, Converter={StaticResource FotoToImageSourceConverter}}" Aspect="AspectFill" HeightRequest="120" WidthRequest="120"/>
                        </Border>
                        <Button Text="{helpers:Translate strSelecionarImagem}" Command="{Binding SelecionarFotoCommand}" Style="{StaticResource ButtonPrimary}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe226;" Color="{AppThemeBinding Light={StaticResource Lime}, Dark={StaticResource Ink}}" />
                            </Button.ImageSource>
                        </Button>
                    </StackLayout>
                </StackLayout>
            </Border>

            <!-- Endereço -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <StackLayout Spacing="15">
                    <Label Text="{helpers:Translate strEndereco}" Style="{StaticResource SubHeadline}"/>

                    <!-- Busca CEP -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Text="{Binding Aluno.Endereco.Cep}" Placeholder="00000-000" Keyboard="Numeric" MaxLength="9" Margin="0,0,10,0" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding SearchByCepCommand}"/>
                        <Button Grid.Column="1" Text="{helpers:Translate strBuscarCep}" Command="{Binding SearchByCepCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="40" Padding="15,0">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="{AppThemeBinding Light={StaticResource Lime}, Dark={StaticResource Ink}}" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <!-- Aviso orientativo se não há endereço vinculado -->
                    <Border Margin="0,5,0,0" Padding="12" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FFF3CD, Dark=#332701}" IsVisible="{Binding HasNoEnderecoVinculado}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="&#xe002;" FontFamily="MaterialIcons" TextColor="#D97706" VerticalOptions="Center" FontSize="20"/>
                            <Label Grid.Column="1" Text="{helpers:Translate strSemLogradouro}" TextColor="{AppThemeBinding Light=#92400E, Dark=#FCD34D}" VerticalOptions="Center" FontSize="13" LineBreakMode="WordWrap"/>
                        </Grid>
                    </Border>

                    <!-- Card com dados do logradouro vinculado -->
                    <Border Margin="0,5,0,0" Padding="12" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}" IsVisible="{Binding HasEnderecoVinculado}">
                        <StackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="6" Margin="0,0,0,4">
                                <Label Text="&#xe876;" FontFamily="MaterialIcons" TextColor="#16A34A" VerticalOptions="Center" FontSize="18"/>
                                <Label Text="{helpers:Translate strLogradouroVinculado}" FontAttributes="Bold" TextColor="#16A34A" VerticalOptions="Center" FontSize="14"/>
                            </HorizontalStackLayout>
                            <Label ><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strRua}"/><Span Text=": "/><Span Text="{Binding Aluno.Endereco.Nome}"/></FormattedString></Label.FormattedText></Label>
                            <Label ><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strBairro}"/><Span Text=": "/><Span Text="{Binding Aluno.Endereco.Bairro}"/></FormattedString></Label.FormattedText></Label>
                            <Label ><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strCidade}"/><Span Text=": "/><Span Text="{Binding Aluno.Endereco.Cidade}"/></FormattedString></Label.FormattedText></Label>
                            <Label ><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strEstado}"/><Span Text=": "/><Span Text="{Binding Aluno.Endereco.Estado}"/></FormattedString></Label.FormattedText></Label>
                            <Label ><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strPais}"/><Span Text=": "/><Span Text="{Binding Aluno.Endereco.Pais}"/></FormattedString></Label.FormattedText></Label>
                        </StackLayout>
                    </Border>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strNumero}"/>
                        <Entry Text="{Binding Aluno.Numero}" Placeholder="{helpers:Translate strNumero}" MaxLength="20" ClearButtonVisibility="WhileEditing"/>
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strComplemento}"/>
                        <Entry Text="{Binding Aluno.Complemento}" Placeholder="{helpers:Translate strComplementoOpcional}" MaxLength="50" ClearButtonVisibility="WhileEditing"/>
                    </StackLayout>
                </StackLayout>
            </Border>

            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="15,10">
                <Button Grid.Column="0" Text="{helpers:Translate strCancelar}" Command="{Binding CancelCommand}" Style="{StaticResource ButtonSecondary}" HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5c9;" Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                    </Button.ImageSource>
                </Button>
                <Button Grid.Column="1" Text="{helpers:Translate strSalvar}" Command="{Binding SaveAlunoCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe161;" Color="{AppThemeBinding Light={StaticResource Lime}, Dark={StaticResource Ink}}" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <!-- Loading Indicator -->
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>

        </StackLayout>
    </ScrollView>
</ContentPage>
