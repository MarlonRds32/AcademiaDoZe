<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroPage"
xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
x:DataType="vm:LogradouroViewModel"
Title="{Binding Title}"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers">
    <ScrollView>
        <StackLayout Spacing="20">
            <!-- CEP Section -->

            <Border Style="{StaticResource CardBorder}" Margin="15,10">

                <StackLayout Spacing="5">
                    <Label Text="{helpers:Translate strCep}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Text="{Binding Logradouro.Cep}" Placeholder="00000-000" Keyboard="Numeric" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Text="{helpers:Translate strBuscarCep}" Command="{Binding SearchByCepCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="40" Padding="15,0"/>
                    </Grid>
                </StackLayout>
            </Border>
            <!-- Dados do Logradouro -->

            <Border Style="{StaticResource CardBorder}" Margin="15,10">

                <StackLayout Spacing="15">
                    <Label Style="{StaticResource SubHeadline}"><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strLogradouroId}"/><Span Text=": "/><Span Text="{Binding Logradouro.Id}"/></FormattedString></Label.FormattedText></Label>
                    <!-- Nome -->

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strNomeRua}"/>
                        <Entry Text="{Binding Logradouro.Nome}" Placeholder="{helpers:Translate strDigiteRua}"/>
                    </StackLayout>
                    <!-- Bairro -->

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strBairro}"/>
                        <Entry Text="{Binding Logradouro.Bairro}" Placeholder="{helpers:Translate strDigiteBairro}"/>
                    </StackLayout>
                    <!-- Cidade -->

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strCidade}"/>
                        <Entry Text="{Binding Logradouro.Cidade}" Placeholder="{helpers:Translate strDigiteCidade}"/>
                    </StackLayout>
                    <!-- Estado -->

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strEstado}"/>
                        <Entry Text="{Binding Logradouro.Estado}" Placeholder="{helpers:Translate strDigiteEstado}"/>
                    </StackLayout>
                    <!-- País -->

                    <StackLayout Spacing="5">
                        <Label Text="{helpers:Translate strPais}"/>
                        <Entry Text="{Binding Logradouro.Pais}" Placeholder="{helpers:Translate strDigitePais}"/>
                    </StackLayout>
                </StackLayout>
            </Border>
            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="15,10">
                <Button Grid.Column="0" Text="{helpers:Translate strCancelar}" Command="{Binding CancelCommand}" Style="{StaticResource ButtonSecondary}" HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5c9;" Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Paper}}" />
                    </Button.ImageSource>
                </Button>
                <Button Grid.Column="1" Text="{helpers:Translate strSalvar}" Command="{Binding SaveLogradouroCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe161;" Color="{AppThemeBinding Light={StaticResource Lime}, Dark={StaticResource Ink}}" />
                    </Button.ImageSource>
                </Button>
            </Grid>
            <!-- Loading Indicator -->

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>

        </StackLayout>
    </ScrollView>
</ContentPage>