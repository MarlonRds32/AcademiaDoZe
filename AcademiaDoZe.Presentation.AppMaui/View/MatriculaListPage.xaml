<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
             x:Name="MatriculasPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:MatriculaListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             Title="{helpers:Translate strMatricula}"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers">

    <!-- Recursos da Página -->
    <ContentPage.Resources>
        <converters:DateOnlyShortToStringConverter x:Key="DateOnlyShort" />
        <converters:FiltroDisplayConverter x:Key="FiltroDisplay" />
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
        <converters:RestricoesFlagsDisplayConverter x:Key="RestricoesDisplay" />

        <!-- Template único para Phone, Tablet, Desktop, TV, Watch e Default -->
        <DataTemplate x:Key="MatriculaItemTemplate" x:DataType="dto:MatriculaDto">
            <Grid Padding="1" Margin="5">
                <Border Style="{StaticResource CardBorder}" Margin="10">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto">

                        <!-- Foto do aluno em moldura elegante -->
                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="5"
                                HeightRequest="110" WidthRequest="110"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource Lime}"
                                StrokeThickness="3"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Margin="0,0,10,0" VerticalOptions="Center">
                            <Image Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                   Aspect="AspectFill" HeightRequest="110" WidthRequest="110"/>
                        </Border>

                        <!-- Nome do aluno -->
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding AlunoMatricula.Nome}" FontAttributes="Bold" FontSize="16" Margin="0,0,0,2" LineBreakMode="TailTruncation"/>

                        <!-- CPF e nascimento -->
                        <Label Grid.Row="1" Grid.Column="0" Margin="0,0,0,4" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="CPF: "/>
                                    <Span Text="{Binding AlunoMatricula.Cpf}"/>
                                    <Span Text="{helpers:Translate strNascAbrev}"/>
                                    <Span Text="{Binding AlunoMatricula.DataNascimento, Converter={StaticResource DateOnlyShort}}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Badge do plano -->
                        <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="6" Margin="0,0,0,4">
                            <Border Padding="8,2" StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                <Label Text="{Binding Plano, Converter={StaticResource EnumDisplay}}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Vigência -->
                        <Label Grid.Row="3" Grid.Column="0" Margin="0,0,0,2" FontSize="12">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{helpers:Translate strVigenciaLbl}" FontAttributes="Bold"/>
                                    <Span Text="{Binding DataInicio, Converter={StaticResource DateOnlyShort}}"/>
                                    <Span Text="{helpers:Translate strAte}"/>
                                    <Span Text="{Binding DataFim, Converter={StaticResource DateOnlyShort}}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Objetivo -->
                        <Label Grid.Row="4" Grid.Column="0" Margin="0,0,0,2" FontSize="12" LineBreakMode="TailTruncation">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{helpers:Translate strObjetivoLbl}" FontAttributes="Bold"/>
                                    <Span Text="{Binding Objetivo}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Restrições médicas -->
                        <Label Grid.Row="5" Grid.Column="0" Margin="0,0,0,2" FontSize="12" LineBreakMode="TailTruncation">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{helpers:Translate strRestricoesLbl}" FontAttributes="Bold"/>
                                    <Span Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Observações -->
                        <Label Grid.Row="6" Grid.Column="0" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" LineBreakMode="TailTruncation" Margin="0,0,0,2"><Label.FormattedText><FormattedString><Span Text="{helpers:Translate strObs}"/><Span Text=": "/><Span Text="{Binding ObservacoesRestricoes}"/></FormattedString></Label.FormattedText></Label>

                        <!-- Botão de ações extras -->
                        <Button Grid.Row="0" Grid.Column="2" Text="" Style="{StaticResource ButtonSmall}" Margin="0,0" Clicked="OnMoreClicked">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5d4;" Color="{AppThemeBinding Light={StaticResource Lime}, Dark={StaticResource Ink}}" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- Lista de Matrículas -->
    <Grid RowDefinitions="Auto,*">

        <!-- Search Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="15,10">
            <Grid ColumnDefinitions="Auto,10,*,10,Auto" VerticalOptions="Center">
                <Picker Grid.Column="0" Title="" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilterType}" WidthRequest="110" HorizontalOptions="Start" HeightRequest="40" VerticalOptions="Center"><Picker.ItemDisplayBinding><Binding Converter="{StaticResource FiltroDisplay}" /></Picker.ItemDisplayBinding></Picker>
                <Entry Grid.Column="2" Text="{Binding SearchText}" Placeholder="{helpers:Translate strDigiteValor}" HeightRequest="40" VerticalOptions="Center" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding SearchMatriculasCommand}"/>
                <Button Grid.Column="4" Text="" Style="{StaticResource ButtonPrimary}" FontSize="14" WidthRequest="80" HeightRequest="40" Command="{Binding SearchMatriculasCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="{AppThemeBinding Light={StaticResource Lime}, Dark={StaticResource Ink}}" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- lista/grade + FAB -->
        <!-- ajuste conforme tipo: Phone, Tablet, Desktop, TV, Watch e Default -->
        <!-- exibe o template criado acima: MatriculaItemTemplate -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Matriculas}" SelectionMode="None" Margin="10">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <!-- Span conforme OnIdiom - utilizando objeto filho -->
                            <!-- lista ou grade -->
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32">
                                    <OnIdiom.Phone>1</OnIdiom.Phone>
                                    <OnIdiom.Default>1</OnIdiom.Default>
                                    <OnIdiom.Tablet>2</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>3</OnIdiom.Desktop>
                                    <OnIdiom.TV>4</OnIdiom.TV>
                                </OnIdiom>
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <StackLayout VerticalOptions="Center">
                            <Label Text="{helpers:Translate strNenhumaMatricula}" HorizontalOptions="Center" Style="{StaticResource SubHeadline}"/>
                            <Button Text="{helpers:Translate strAdicionarPrimeiraMatricula}" Command="{Binding AddMatriculaCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="50" Margin="0,20,0,0"/>
                        </StackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <StaticResource Key="MatriculaItemTemplate" />
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- FAB -->
            <Button Text="" Command="{Binding AddMatriculaCommand}" Style="{StaticResource ButtonPrimary}" WidthRequest="56" HeightRequest="56" HorizontalOptions="End" VerticalOptions="End" Margin="20">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=Black, Dark=Gray}" Offset="0,4" Radius="8" Opacity="0.3"/>
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Color="{AppThemeBinding Light={StaticResource Lime}, Dark={StaticResource Ink}}" />
                </Button.ImageSource>
            </Button>
        </Grid>

        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
